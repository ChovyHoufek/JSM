	TON_10: TON;
	
	// druhy mereni
	
	bMereni1 : BOOL ;
	bMereni2 : BOOL ;

	R_TRIG_2: R_TRIG;
	fbRefTab: FB_refTable_2 ;
	TON_4: TON;
	TON_Pod_Pas: TON;
	
	// tag pro pas
	PovoleniPas : BOOL ;
	
END_VAR

]]></Declaration>
