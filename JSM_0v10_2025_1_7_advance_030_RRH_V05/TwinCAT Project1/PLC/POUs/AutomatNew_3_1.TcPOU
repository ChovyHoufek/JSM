	// tolerance pro royjet9 p8su 
	
	tolerance : REAL ;
	
	
	// Fb
	Scale_proud :FbScale ;
	stopPasu : R_TRIG ;
	TON_0 : TON ;
	TON_1: TON;
	TON_2: TON;
	R_TRIG_1: R_TRIG;
	TON_3: TON;
	R_TRIG_0 : R_TRIG;
	TON_5: TON;
	TON_6: TON;
