<div id="obrobekIndicator" data-tchmi-type="TcHmi.Controls.System.TcHmiGrid" data-tchmi-grid-column-index="1" data-tchmi-grid-row-index="0" data-tchmi-height="26" data-tchmi-height-unit="px" data-tchmi-left="50" data-tchmi-left-unit="px" data-tchmi-top-unit="px" data-tchmi-width="962" data-tchmi-width-unit="px" data-tchmi-top="532" data-tchmi-creator-visibility="Visible">
    <div id="obrobekBar" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiRectangle" data-tchmi-grid-column-index="0" data-tchmi-grid-row-index="0" data-tchmi-height="100" data-tchmi-height-unit="%" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-top="5" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-right="0" data-tchmi-creator-visibility="Visible" data-tchmi-is-enabled="true">
        <script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%s%PLC1.Machine_Inputs.I_detekce_obrobku_EMS%/s%",
    "actions": [
      {
        "objectType": "Condition",
        "active": true,
        "parts": [
          {
            "if": [
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "symbolExpression": "%s%PLC1.Machine_Inputs.I_detekce_obrobku_EMS%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "compareOperator": "==",
                "logic": null
              }
            ],
            "then": [
              {
                "objectType": "JavaScript",
                "active": true,
                "sourceLines": [
                  "let el = document.getElementById(\"obrobekBar\");",
                  "",
                  "TcHmi.Symbol.readEx2(\"%s%PLC1.HMI_prom.UI_rq_rychlost_podav_pas%/s%\", function(data) {",
                  "    el.style.animation = \"none\";",
                  "    void el.offsetWidth;",
                  "    let speed = data.value / 60; // data obsahuje hodnotu rychlosti z PLC",
                  "    let time = 2.0 / speed; // čas podle rychlosti",
                  "     // spuštění animace",
                  "     el.style.animation = `shrinkBar ${time}s alternate`;",
                  "     el.style.animationPlayState = \"running\"; ",
                  "});"
                ],
                "injectContextObject": false,
                "asyncWait": true,
                "waitMode": "Synchronous"
              },
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%i%isAnimationPlayed%/i%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "asyncWait": true
              },
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%i%animStopped%/i%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": false
                },
                "asyncWait": true
              }
            ]
          },
          {
            "else": []
          }
        ],
        "asyncWait": true
      }
    ]
  },
  {
    "event": "obrobekBar.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "let el = document.getElementById(\"obrobekBar\");",
          "",
          "TcHmi.Symbol.readEx2(\"%s%PLC1.HMI_prom.UI_rq_rychlost_podav_pas%/s%\", function(data) {",
          "    el.style.animation = \"none\";",
          "    void el.offsetWidth;",
          "    let speed = data.value / 60; // data obsahuje hodnotu rychlosti z PLC",
          "    let time = 2.0 / speed; // čas podle rychlosti",
          "     // spuštění animace",
          "     el.style.animation = `shrinkBar 5s alternate`;",
          "     el.style.animationPlayState = \"running\"; ",
          "});"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%isAnimationPlayed%/i%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/BOOL",
          "value": true
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%animStopped%/i%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/BOOL",
          "value": false
        },
        "asyncWait": true
      }
    ]
  }
]
</script>
    </div>
</div>
</div>